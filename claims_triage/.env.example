# ── Claims Triage System ──────────────────────────────────────────
# App
APP_NAME=Claims Triage System
DEBUG=true
LOG_LEVEL=INFO

# OpenAI
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.1

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=claims_triage
POSTGRES_USER=claims_user
POSTGRES_PASSWORD=claims_pass

# Budget Ceilings
MAX_TOKENS=50000
MAX_WALL_CLOCK_SECONDS=300

# Human Gate
HUMAN_GATE_CONFIDENCE_THRESHOLD=0.8
HUMAN_GATE_SEVERITY_TRIGGER=high
